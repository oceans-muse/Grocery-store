# oceans-muse · local configuration
# Copy this file to `.env` and change the password before sharing the site.

PORT=4310
HOST=127.0.0.1

# Initial admin account. Only used on the very first boot (when the users table is empty).
ADMIN_USER=admin
ADMIN_PASSWORD=liquid-glass-2026

# Use a long random string in production.
IP_SALT=change-me-to-a-long-random-string

# Optional: public origin used in RSS, sitemap and canonical URLs.
# SITE_ORIGIN=https://your-domain.example

# Set to 1 when serving behind an HTTPS reverse proxy.
# COOKIE_SECURE=1
